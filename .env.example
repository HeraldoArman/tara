# Local Compose only. Copy to .env and replace every placeholder before startup.
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-local-database-password
S3_ACCESS_KEY_ID=tara-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
S3_BUCKET=tara-evidence
APP_ORIGIN=http://localhost:3001
DEMO_PASSWORD=replace-with-your-local-demo-password
# Required only for the realtime profile. Never expose these as NEXT_PUBLIC values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=tara-agent-local
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
VISION_MODEL=gpt-6.1-terra
SOP_OPENAI_API_KEY=
SOP_MODEL=gpt-6.1-sol
MAX_PDF_PAGES=250
MAX_SOURCE_CHARACTERS=300000
# OpenAI search reuses OPENAI_API_KEY. Brave is an optional alternative.
WEB_SEARCH_PROVIDER=openai
WEB_SEARCH_MODEL=gpt-6-luna
WEB_SEARCH_API_KEY=
